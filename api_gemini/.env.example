# ============================================
# API GEMINI - ENVIRONMENT VARIABLES
# ============================================

# --- GEMINI API KEYS ---
# Lấy tại: https://makersuite.google.com/app/apikey
# Thêm nhiều keys để tránh rate limit
API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
API_KEY_2=AIzaSyYYYYYYYYYYYYYYYYYYYYYYYYYYYY
API_KEY_3=AIzaSyZZZZZZZZZZZZZZZZZZZZZZZZZZZZ

# --- DATABASE CONFIGURATION ---
# Nếu MySQL chạy trên máy host (không phải Docker):
DB_HOST=host.docker.internal

# Nếu MySQL chạy trong Docker cùng network:
# DB_HOST=db

# Nếu MySQL chạy trên server khác:
# DB_HOST=192.168.1.100

DB_PORT=3306
DB_NAME=ants_ktc
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# --- FLASK CONFIGURATION ---
FLASK_ENV=production
FLASK_DEBUG=0

# ============================================
# LƯU Ý:
# - Thay đổi tất cả các giá trị XXX, YYY, ZZZ bằng API keys thực
# - Thay your_mysql_password_here bằng password MySQL thực tế
# - KHÔNG commit file này lên Git
# ============================================
